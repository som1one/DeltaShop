# PostgreSQL (используется docker-compose для связи контейнеров)
DATABASE_URL=postgresql://deltashop:changeme@db:5432/deltashop
POSTGRES_PASSWORD=changeme

# Robokassa (https://partner.robokassa.ru → Настройки магазина)
# Пока переменные пусты, чекаут работает в демо-режиме без списаний.
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# Тестовый режим Robokassa (используются «тестовые пароли» из кабинета)
ROBOKASSA_TEST=1

# В кабинете Robokassa укажите URL-ы (метод POST):
#   ResultURL:  https://<домен>/api/robokassa/result
#   SuccessURL: https://<домен>/checkout/success
#   FailURL:    https://<домен>/checkout/fail

# ЮKassa (https://yookassa.ru → Настройки → Ключи API)
# Ключ вида live_… списывает НАСТОЯЩИЕ деньги, test_… — тестовый режим.
# Пока переменные пусты, чекаут работает в демо-режиме без списаний.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда ЮKassa вернёт покупателя и на какой домен ссылается сайт
SITE_URL=https://forma-visual.com

# В кабинете ЮKassa укажите URL для уведомлений (события payment.succeeded,
# payment.canceled):
#   https://<домен>/api/yookassa/notify

# Ключ мини-админки /admin (обязательно смените для продакшена)
ADMIN_PASSWORD=

# HTTPS (Let's Encrypt). Первый выпуск: sh scripts/init-letsencrypt.sh
DOMAIN=forma-visual.com
# Почта для писем об истечении сертификата — обязательна при выпуске
CERTBOT_EMAIL=
